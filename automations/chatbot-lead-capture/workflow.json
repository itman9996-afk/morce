{
  "name": "Chatbot Lead Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chatbot-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "chatbot-lead"
    },
    {
      "parameters": {
        "jsCode": "// اعتبارسنجی ورودی چت‌بات — هیچ فیلد اضافه‌ای قبول نمی‌شود\nconst b = $input.first().json.body ?? $input.first().json;\nconst rawPhone = String(b.phone ?? '').replace(/[^0-9+]/g, '');\nconst phone = rawPhone.startsWith('+98') ? '0' + rawPhone.slice(3) : rawPhone;\nconst name = typeof b.name === 'string' ? b.name.trim() : '';\nconst valid = name.length >= 2 && name.length <= 80 && /^09\\d{9}$/.test(phone) && b.consent === true;\nreturn [{ json: {\n  valid,\n  lead: valid ? {\n    name,\n    phone,\n    business: typeof b.business === 'string' ? b.business.slice(0, 120) : null,\n    message: typeof b.message === 'string' ? b.message.slice(0, 2000) : null,\n    consent_status: 'granted',\n    consent_timestamp: new Date().toISOString(),\n    source: 'website-chatbot',\n    lead_id: 'LEAD-' + Date.now().toString(36).toUpperCase()\n  } : null,\n  errors: valid ? [] : ['name/phone/consent نامعتبر است']\n} }];"
      },
      "id": "b2c3d4e5-validate",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3d4e5f6-if",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, message: 'lead accepted', lead_id: $json.lead.lead_id }) }}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "d4e5f6a7-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, errors: $json.errors }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "e5f6a7b8-bad",
      "name": "Respond Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 100]
    }
  ],
